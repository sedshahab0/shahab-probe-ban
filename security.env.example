# Copy to /etc/probe-ban/security.env (or run: probe-ban.sh --wizard)

PROBE_BAN_SERVER_LABEL=web-1
PROBE_BAN_WHITELIST_IPS=203.0.113.10,203.0.113.11
PROBE_BAN_AUTO_BAN=1
PROBE_BAN_TTL_DAYS=30
PROBE_BAN_TRUSTED_CIDRS=
PROBE_BAN_PROBE_LOG=/var/log/nginx/probes.log
PROBE_BAN_STATE_DIR=/var/lib/probe-ban
PROBE_BAN_ALERT_TELEGRAM=0
PROBE_BAN_TELEGRAM_ENV=/etc/probe-ban/telegram.env
PROBE_BAN_SYNC_PEER=0
PROBE_BAN_PUSH_PEER=0
PROBE_BAN_PEER_IP=
PROBE_BAN_BAN_CRON="*/5 * * * *"
PROBE_BAN_EXPIRE_CRON="15 4 * * *"
